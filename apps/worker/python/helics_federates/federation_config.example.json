      "interpreter": "python",
      "options": {
        "setpoints_path": "scenarios/synthetic-portfolio/setpoints-fixture.json"
      },
      "publications": [
        { "topic": "flexcore/control/site-north-bess-1/setpoint_p_mw", "unit": "MW", "kind": "double" }
