      "subscriptions": [
        { "topic": "flexcore/control/site-north-bess-1/setpoint_p_mw", "unit": "MW", "kind": "double" }
      ]
    },
    {
      "name": "flexcore_grid",
      "role": "grid",
      "script_path": "apps/worker/python/helics_federates/grid_federate.py",
      "interpreter": "python",
      "options": {
        "grid_worker_script": "apps/worker/python/grid_worker.py",
