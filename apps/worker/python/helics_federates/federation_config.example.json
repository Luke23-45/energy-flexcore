        "bus_map": {
          "site-north-bess-1": "bus_2",
          "site-north-pv-1": "bus_3"
        }
      },
      "publications": [
        { "topic": "flexcore/grid/bus/bus_2/vm_pu", "unit": "pu", "kind": "double" },
        { "topic": "flexcore/grid/bus/bus_3/vm_pu", "unit": "pu", "kind": "double" }
      ],
      "subscriptions": [
        { "topic": "flexcore/asset/site-north-bess-1/p_mw", "unit": "MW", "kind": "double" },
        { "topic": "flexcore/asset/site-north-bess-1/q_mvar", "unit": "MVAr", "kind": "double" },
        { "topic": "flexcore/asset/site-north-pv-1/p_mw", "unit": "MW", "kind": "double" }
