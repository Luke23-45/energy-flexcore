      "manifest-id": "builtin.simulator-telemetry",
      "version-constraint": ">=0.5.0"
    },
    {
      "manifest-id": "builtin.highs-optimizer",
      "version-constraint": ">=0.5.0"
    },
    {
      "manifest-id": "builtin.pandapower-grid",
      "version-constraint": ">=0.5.0"
    }
