# FlexCore Compose stack — example environment file (Patch B, P2.07).
#
# Copy to `.env` (gitignored) and fill in REAL values. NOTHING in this
# file is a credential: every value below is a placeholder that must be
# replaced before the first start. Never commit a filled-in `.env`.
#
# Generate the values with:
#   openssl rand -base64 32   # JETSTREAM_ENCRYPTION_KEY (at least 32 bytes;
#                             # the server HMAC-hashes it on startup)
#   openssl rand -base64 24   # each NATS_*_PASSWORD
#
# Certificates are NOT .env values: provision
#   ./secrets/nats-certs/server-cert.pem
#   ./secrets/nats-certs/server-key.pem   (0600)
#   ./secrets/nats-certs/ca.pem
# before the first start (server cert SAN must cover `nats`, the name
# clients dial). See nats-server.conf and the compose README section.

# JetStream encryption at rest (nats-server.conf `jetstream.key`).
# REQUIRED: the nats service fails to start without it.
JETSTREAM_ENCRYPTION_KEY=REPLACE-ME-generate-with-openssl-rand-base64-32

# NATS authorization users (nats-server.conf `authorization.users`).
# REQUIRED: one password per user; the worker, source, and control-plane
# services authenticate as these users.
NATS_WORKER_PASSWORD=REPLACE-ME
NATS_SOURCE_PASSWORD=REPLACE-ME
NATS_CONTROL_PLANE_PASSWORD=REPLACE-ME
